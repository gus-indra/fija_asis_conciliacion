# Debe coincidir con el resultado de: id -u
# Ejemplo común en Ubuntu WSL: 1000
AIRFLOW_UID=1000

# PostgreSQL / Metadata DB de Airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Usuario para Airflow 3 Simple Auth Manager
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS=admin:admin
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_ALL_ADMINS=true
AIRFLOW_JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_LARGO
# Usuario inicial para la interfaz web
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_FIRSTNAME=Gustavo
AIRFLOW_ADMIN_LASTNAME=Alvarado
AIRFLOW_ADMIN_EMAIL=admin@local.test
AIRFLOW_ADMIN_PASSWORD=cambia_esta_clave

# Puerto expuesto en Windows
AIRFLOW_WEB_PORT=8080